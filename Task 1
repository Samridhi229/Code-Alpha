# To-Do List Application

tasks = []

def add_task():
    task = input("Enter task: ")
    tasks.append({"task": task, "status": "Pending"})
    print("Task added successfully!")

def view_tasks():
    if not tasks:
        print("No tasks available.")
    else:
        print("\n--- To-Do List ---")
        for i, task in enumerate(tasks, 1):
            print(f"{i}. {task['task']} - {task['status']}")

def update_task():
    view_tasks()
    if tasks:
        n = int(input("Enter task number to update: "))
        if 1 <= n <= len(tasks):
            new_task = input("Enter new task: ")
            tasks[n - 1]["task"] = new_task
            print("Task updated successfully!")
        else:
            print("Invalid task number.")

def delete_task():
    view_tasks()
    if tasks:
        n = int(input("Enter task number to delete: "))
        if 1 <= n <= len(tasks):
            tasks.pop(n - 1)
            print("Task deleted successfully!")
        else:
            print("Invalid task number.")

def complete_task():
    view_tasks()
    if tasks:
        n = int(input("Enter task number to mark completed: "))
        if 1 <= n <= len(tasks):
            tasks[n - 1]["status"] = "Completed"
            print("Task marked as completed!")
        else:
            print("Invalid task number.")

while True:
    print("\n===== TO-DO LIST =====")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Update Task")
    print("4. Delete Task")
    print("5. Mark Task Completed")
    print("6. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        add_task()
    elif choice == "2":
        view_tasks()
    elif choice == "3":
        update_task()
    elif choice == "4":
        delete_task()
    elif choice == "5":
        complete_task()
    elif choice == "6":
        print("Thank you for using To-Do List!")
        break
    else:
        print("Invalid choice. Please try again.")

